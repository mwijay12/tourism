# ==========================================================
# KIBO & PLAINS — ENVIRONMENT VARIABLES (.env.local / Vercel)
# Copy this file to `.env.local` and fill in your credentials.
# ==========================================================

# 1. FIREBASE (Web App + Google Auth + Firestore)
# From Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated Google emails allowed into /admin
# Example: mwijay12@gmail.com,concierge@altraware.com
NEXT_PUBLIC_ADMIN_EMAILS=

# 2. CLOUDINARY (Media Upload & CDN Optimization)
# From Cloudinary Dashboard -> Programmable Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# 3. NODEMAILER SMTP (Itinerary Dossiers & Admin Dispatch Emails)
# Works with Gmail App Password, Resend SMTP, Zoho, Postmark, or Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kibo & Plains Tanzania <hello@kiboplains.tz>"
ADMIN_NOTIFY_EMAIL=
